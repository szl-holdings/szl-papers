  "hypotheses": [
    {
      "id": "H1",
      "claim": "Source-bound, independent verification reduces false-positive admission of tampered simulated robot-action evidence",
      "primary_metric": "false_admission_rate",
      "unit": "proportion",
      "denominator": "preregistered_adversarial_episodes",
      "baseline": "status-only / unsigned metadata display",
      "target": "zero false admission among >=1000 preregistered negative fixtures; report uncertainty upper bound",
      "measured_value": null,
      "baseline_measured_value": null
    },
    {
      "id": "H2",
      "claim": "Proof-linked 3D evidence visualization reduces investigation time on matched incidents relative to 2D logs",
      "primary_metric": "fault_localization_p95",
      "unit": "seconds",
      "denominator": "paired_incident_tasks_with_ground_truth",
      "baseline": "existing 2D receipt/log table under identical scenario set",
      "target": "noninferiority on accuracy, lower p95 time with confidence interval",
      "measured_value": null,
      "baseline_measured_value": null
    },
    {
      "id": "H3",
      "claim": "A compact action passport achieves bounded runtime overhead while preserving independently verifiable lineage",
      "primary_metric": "verification_latency_p95",
      "unit": "milliseconds",
      "denominator": "verified_simulated_receipt_attempts",
      "baseline": "signed JSON event log with same source binding and equivalent rights checks",
      "target": "preregister overhead budget and compare bytes/episode, p95 latency and failure counts",
      "measured_value": null,
      "baseline_measured_value": null
    }
  ],
